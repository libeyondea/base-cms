{
	"name": "@libeyondea/base-cms",
	"version": "1.0.8",
	"type": "module",
	"description": "Base CMS library for React",
	"author": "Nguyen Thuc",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/libeyondea/base-cms.git"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev --workspace=@libeyondea/base-cms",
		"build": "npm run build --workspace=@libeyondea/base-cms",
		"lint": "npm run lint --workspace=@libeyondea/base-cms",
		"preview": "npm run preview --workspace=@libeyondea/base-cms",
		"publish:all": "node scripts/publish.sh",
		"publish:all:win": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1",
		"clean": "rimraf packages/*/node_modules packages/*/dist node_modules",
		"reinstall": "npm run clean && npm install"
	}
}
