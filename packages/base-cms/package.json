{
	"name": "@libeyondea/base-cms",
	"version": "1.0.8",
	"type": "module",
	"description": "Base CMS library for React",
	"author": "Nguyen Thuc",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/libeyondea/base-cms.git"
	},
	"keywords": [
		"react",
		"cms",
		"admin",
		"mui"
	],
	"main": "./dist/base-cms.umd.js",
	"module": "./dist/base-cms.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/base-cms.es.js",
			"require": "./dist/base-cms.umd.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite --port 1000",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview --port 1000"
	},
	"peerDependencies": {
		"@reduxjs/toolkit": "^2.9.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.9.3"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@hookform/resolvers": "5.2.2",
		"@mui/icons-material": "7.3.4",
		"@mui/material": "7.3.4",
		"@mui/system": "7.3.3",
		"@mui/x-date-pickers": "8.12.0",
		"@tanstack/react-query": "5.90.2",
		"@tanstack/react-table": "8.21.3",
		"axios": "1.12.2",
		"js-cookie": "3.0.5",
		"lodash-es": "4.17.21",
		"moment": "2.30.1",
		"qs": "6.14.0",
		"react-big-calendar": "1.19.4",
		"react-hook-form": "7.63.0",
		"react-icons": "5.5.0",
		"react-number-format": "5.4.4",
		"react-toastify": "11.0.5",
		"sweetalert2": "11.23.0",
		"yup": "1.7.1"
	},
	"devDependencies": {
		"@libeyondea/base-cms-dev": "*"
	}
}
