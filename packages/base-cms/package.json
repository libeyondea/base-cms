{
	"name": "@libeyondea/base-cms",
	"version": "1.0.19",
	"type": "module",
	"description": "Base CMS library for React",
	"author": "Nguyen Thuc",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/libeyondea/base-cms.git"
	},
	"keywords": [
		"react",
		"cms",
		"admin",
		"mui"
	],
	"main": "./dist/base-cms.umd.js",
	"module": "./dist/base-cms.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/base-cms.es.js",
			"require": "./dist/base-cms.umd.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite --port 1000",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview --port 1000"
	},
	"dependencies": {},
